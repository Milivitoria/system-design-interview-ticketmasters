# Application
PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticketmasterdb
DB_USERNAME=ticketmaster
DB_PASSWORD=ticketmaster

# JWT (paths to PEM files relative to project root)
JWT_PRIVATE_KEY_PATH=src/keys/rsaPrivateKey.pem
JWT_PUBLIC_KEY_PATH=src/keys/publicKey.pem
JWT_ISSUER=ticketmaster
JWT_EXPIRES_IN=300

# AWS SQS (LocalStack for local dev)
AWS_REGION=sa-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test-key
AWS_SECRET_ACCESS_KEY=test-secret
SQS_QUEUE_NAME=check-booking-pending-state

# Booking expiration delay (seconds)
BOOKING_EXPIRATION_CHECK_SECONDS=30
